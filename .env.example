OPENAI_API_KEY=
BRAVE_SEARCH_API_KEY=
APOLLO_API_KEY=

# data.gov.in API key (My Account > API Keys on data.gov.in)
DATA_GOV_API_KEY=
# Comma-separated resource id(s) for the "Company Master Data" dataset
# (published per state/UT) from https://data.gov.in — find via the catalog
# search for "Company Master Data" and copy each resource's id from its
# API page ("Data API" tab).
DATA_GOV_MCA_RESOURCE_IDS=

# SEC EDGAR requires no API key, but every request must declare a
# User-Agent identifying the app and a real contact email (SEC's own
# format, per sec.gov/os/accessing-edgar-data: "Company Name contact@domain").
SEC_USER_AGENT=YourAppName your-real-email@example.com

# OpenCorporates API token (opencorporates.com/api_accounts/new). Required —
# OpenCorporates returns HTTP 401 on both search and company lookups without
# a valid api_token, even for otherwise-public data.
OPENCORPORATES_API_KEY=

MONGODB_URI=mongodb://127.0.0.1:27017/company_research
PORT=5050
